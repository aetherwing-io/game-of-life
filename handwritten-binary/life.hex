# ============================================================================
# life.hex — a hand-written x86-64 Linux ELF executable. No compiler. No
# assembler. No linker. Every byte below was authored directly by an LLM:
# ELF header, program header, machine-code encodings (ModRM/SIB/REX bytes and
# jump displacements computed by hand), and data.
#
# The program runs Conway's Game of Life: a glider on an 8x8 torus, printing
# 16 generations to stdout using only raw syscalls (write=1, exit=60).
#
# Build (pure hex-to-bytes conversion, no translation of any kind):
#   sed 's/#.*//' life.hex | xxd -r -p > life && chmod +x life
#
# Memory map (single RWX PT_LOAD segment at 0x400000, mapped from file off 0):
#   0x400078  code (entry point)
#   0x400200  board     (64 bytes, current generation, 1 byte per cell)
#   0x400240  next      (64 bytes, next generation scratch)
#   0x400280  outbuf    (73 bytes: 8 rows x (8 cells + '\n') + blank line)
# ============================================================================

# ---------------------------------------------------------------- ELF header
7F 45 4C 46                            # magic "\x7fELF"
02 01 01 00                            # 64-bit, little-endian, ELF v1, SysV
00 00 00 00 00 00 00 00                # padding
02 00                                  # e_type    = ET_EXEC
3E 00                                  # e_machine = EM_X86_64
01 00 00 00                            # e_version = 1
78 00 40 00 00 00 00 00                # e_entry   = 0x400078
40 00 00 00 00 00 00 00                # e_phoff   = 0x40
00 00 00 00 00 00 00 00                # e_shoff   = 0 (no sections)
00 00 00 00                            # e_flags
40 00                                  # e_ehsize  = 64
38 00                                  # e_phentsize = 56
01 00                                  # e_phnum   = 1
00 00 00 00 00 00                      # e_shentsize/e_shnum/e_shstrndx = 0

# ------------------------------------------------------ program header (0x40)
01 00 00 00                            # p_type  = PT_LOAD
07 00 00 00                            # p_flags = RWX (crude, but simple)
00 00 00 00 00 00 00 00                # p_offset = 0
00 00 40 00 00 00 00 00                # p_vaddr  = 0x400000
00 00 40 00 00 00 00 00                # p_paddr
C9 02 00 00 00 00 00 00                # p_filesz = 0x2C9 (713)
C9 02 00 00 00 00 00 00                # p_memsz  = 0x2C9
00 10 00 00 00 00 00 00                # p_align  = 0x1000

# ------------------------------------------------- code, file offset 0x78
# Register plan: r8=board  r9=next  r10=outbuf  r15=generations remaining
#                ecx/edx = y/x loop counters   ebx = neighbour count
#
# _start:                                        (code-relative offset 0)
49 B8 00 02 40 00 00 00 00 00          # mov r8,  0x400200        ; board
49 B9 40 02 40 00 00 00 00 00          # mov r9,  0x400240        ; next
49 BA 80 02 40 00 00 00 00 00          # mov r10, 0x400280        ; outbuf
49 C7 C7 10 00 00 00                   # mov r15, 16              ; generations

# gen_loop:                                      (offset 37)
# -- render board into outbuf ('.' dead, '#' alive, '\n' every 8 cells) --
4D 89 D3                               # mov r11, r10             ; write ptr
31 C9                                  # xor ecx, ecx             ; cell idx
# render_loop:                                   (offset 42)
B0 2E                                  # mov al, '.'
41 80 3C 08 00                         # cmp byte [r8+rcx], 0
74 02                                  # je +2 (skip next insn)
B0 23                                  # mov al, '#'
41 88 03                               # mov [r11], al
49 FF C3                               # inc r11
89 C8                                  # mov eax, ecx
83 E0 07                               # and eax, 7
83 F8 07                               # cmp eax, 7
75 07                                  # jne +7 (skip newline)
41 C6 03 0A                            # mov byte [r11], '\n'
49 FF C3                               # inc r11
FF C1                                  # inc ecx
83 F9 40                               # cmp ecx, 64
75 D7                                  # jne render_loop (-41)
41 C6 03 0A                            # mov byte [r11], '\n'     ; blank line
# -- write(1, outbuf, 73) --
B8 01 00 00 00                         # mov eax, 1               ; SYS_write
BF 01 00 00 00                         # mov edi, 1               ; stdout
4C 89 D6                               # mov rsi, r10
BA 49 00 00 00                         # mov edx, 73
0F 05                                  # syscall

# -- compute next generation (torus: coordinates wrap with AND 7) --
31 C9                                  # xor ecx, ecx             ; y = 0
# y_loop:                                        (offset 109)
31 D2                                  # xor edx, edx             ; x = 0
# x_loop:                                        (offset 111)
31 DB                                  # xor ebx, ebx             ; count = 0
BE FF FF FF FF                         # mov esi, -1              ; dy
# dy_loop:                                       (offset 118)
BF FF FF FF FF                         # mov edi, -1              ; dx
# dx_loop:                                       (offset 123)
89 F0                                  # mov eax, esi
09 F8                                  # or  eax, edi
74 15                                  # jz skip_self (+21)       ; dx=dy=0
8D 04 31                               # lea eax, [rcx+rsi]       ; y+dy
83 E0 07                               # and eax, 7               ; wrap
C1 E0 03                               # shl eax, 3               ; *8
8D 2C 3A                               # lea ebp, [rdx+rdi]       ; x+dx
83 E5 07                               # and ebp, 7               ; wrap
01 E8                                  # add eax, ebp             ; idx
41 02 1C 00                            # add bl, [r8+rax]         ; count += cell
# skip_self:                                     (offset 150)
FF C7                                  # inc edi
83 FF 02                               # cmp edi, 2
75 DE                                  # jne dx_loop (-34)
FF C6                                  # inc esi
83 FE 02                               # cmp esi, 2
75 D2                                  # jne dy_loop (-46)
# -- apply rule: alive' = (count==3) or (count==2 and alive) --
89 C8                                  # mov eax, ecx
C1 E0 03                               # shl eax, 3
01 D0                                  # add eax, edx             ; idx = y*8+x
45 8A 24 00                            # mov r12b, [r8+rax]       ; current cell
45 31 ED                               # xor r13d, r13d           ; result = 0
80 FB 03                               # cmp bl, 3
74 0A                                  # je set_alive (+10)
80 FB 02                               # cmp bl, 2
75 08                                  # jne store (+8)
45 84 E4                               # test r12b, r12b
74 03                                  # jz store (+3)
# set_alive:                                     (offset 193)
41 B5 01                               # mov r13b, 1
# store:                                         (offset 196)
45 88 2C 01                            # mov [r9+rax], r13b
FF C2                                  # inc edx
83 FA 08                               # cmp edx, 8
75 A0                                  # jne x_loop (-96)
FF C1                                  # inc ecx
83 F9 08                               # cmp ecx, 8
75 97                                  # jne y_loop (-105)

# -- copy next -> board --
31 C9                                  # xor ecx, ecx
# copy_loop:                                     (offset 216)
41 8A 04 09                            # mov al, [r9+rcx]
41 88 04 08                            # mov [r8+rcx], al
FF C1                                  # inc ecx
83 F9 40                               # cmp ecx, 64
75 F1                                  # jne copy_loop (-15)

49 FF CF                               # dec r15
0F 85 35 FF FF FF                      # jnz gen_loop (-203)

# -- exit(0) --
B8 3C 00 00 00                         # mov eax, 60              ; SYS_exit
31 FF                                  # xor edi, edi
0F 05                                  # syscall
# code ends at file offset 0x171 (369)

# ------------------------------------- padding to file offset 0x200 (143 x 00)
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00

# --------------------------- board @ 0x400200: a glider, top-left at (1,1)
# . . . . . . . .
# . . # . . . . .
# . . . # . . . .
# . # # # . . . .
# (rows 4-7 empty)
00 00 00 00 00 00 00 00
00 00 01 00 00 00 00 00
00 00 00 01 00 00 00 00
00 01 01 01 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00

# --------------------------- next @ 0x400240: 64 bytes scratch
00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00

# --------------------------- outbuf @ 0x400280: 73 bytes
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00 00
# file ends at offset 0x2C9 (713 bytes)
