# dx_loop:                                         (offset 192)
89 F0                                  # mov eax, esi
09 F8                                  # or  eax, edi
74 15                                  # jz skip_self (+21)
8D 04 31                               # lea eax, [rcx+rsi]
83 E0 0F                               # and eax, 15
C1 E0 04                               # shl eax, 4
8D 2C 3A                               # lea ebp, [rdx+rdi]
83 E5 0F                               # and ebp, 15
01 E8                                  # add eax, ebp
41 02 1C 00                            # add bl, [r8+rax]
# skip_self:                                       (offset 219)
FF C7                                  # inc edi
83 FF 02                               # cmp edi, 2
75 DE                                  # jne dx_loop (-34)
FF C6                                  # inc esi
83 FE 02                               # cmp esi, 2
75 D2                                  # jne dy_loop (-46)
89 C8                                  # mov eax, ecx
C1 E0 04                               # shl eax, 4
01 D0                                  # add eax, edx         ; idx = y*16+x
45 8A 24 00                            # mov r12b, [r8+rax]
45 31 ED                               # xor r13d, r13d
80 FB 03                               # cmp bl, 3
74 0A                                  # je set_alive (+10)
80 FB 02                               # cmp bl, 2
75 08                                  # jne store (+8)
45 84 E4                               # test r12b, r12b
74 03                                  # jz store (+3)
# set_alive:                                       (offset 262)
41 B5 01                               # mov r13b, 1
# store:                                           (offset 265)
45 88 2C 01                            # mov [r9+rax], r13b
FF C2                                  # inc edx
83 FA 10                               # cmp edx, 16
75 A0                                  # jne x_loop (-96)
FF C1                                  # inc ecx
83 F9 10                               # cmp ecx, 16
75 97                                  # jne y_loop (-105)
# -- copy next -> board --
31 C9                                  # xor ecx, ecx
# copy_loop:                                       (offset 285)
41 8A 04 09                            # mov al, [r9+rcx]
41 88 04 08                            # mov [r8+rcx], al
FF C1                                  # inc ecx
81 F9 00 01 00 00                      # cmp ecx, 256
75 EE                                  # jne copy_loop (-18)
49 FF CF                               # dec r15
0F 85 1B FF FF FF                      # jnz gen_loop (-229)
# -- exit(0) --
B8 3C 00 00 00                         # mov eax, 60
31 FF                                  # xor edi, edi
0F 05                                  # syscall
# code ends at offset 321 (file 0x1B9)

