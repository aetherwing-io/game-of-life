BA 18 01 00 00                         # mov edx, 280
0F 05                                  # syscall
# -- nanosleep(&ts, NULL) --
B8 23 00 00 00                         # mov eax, 35
48 BF 18 05 40 00 00 00 00 00          # mov rdi, 0x400518
31 F6                                  # xor esi, esi
0F 05                                  # syscall

# -- next generation, 16x16 torus (wrap with AND 15) --
31 C9                                  # xor ecx, ecx         ; y
# y_loop:                                          (offset 178)
31 D2                                  # xor edx, edx         ; x
# x_loop:                                          (offset 180)
31 DB                                  # xor ebx, ebx         ; count
BE FF FF FF FF                         # mov esi, -1          ; dy
# dy_loop:                                         (offset 187)
